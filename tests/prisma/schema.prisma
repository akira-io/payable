// Test-only Prisma schema (SQLite) for the PrismaStorageDriver contract suite.
// Generated client is consumed by tests/support/prisma.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("PAYABLE_PRISMA_TEST_URL")
}

model PayableCustomer {
  id                 String                             @id
  tenantId           String?                            @map("tenant_id")
  tenantKey          String                             @default("") @map("tenant_key")
  billableType       String                             @map("billable_type")
  billableId         String                             @map("billable_id")
  email              String
  name               String?
  metadata           String?
  createdAt          DateTime                           @map("created_at")
  updatedAt          DateTime                           @map("updated_at")
  providerBindings   PayableCustomerProviderBinding[]
  providerSyncStates PayableCustomerProviderSyncState[]

  @@unique([tenantKey, billableType, billableId])
  @@index([tenantKey, createdAt, id])
  @@map("payable_customers")
}

model PayableCustomerProviderBinding {
  id                 String          @id
  customerId         String          @map("customer_id")
  provider           String
  providerCustomerId String          @map("provider_customer_id")
  createdAt          DateTime        @map("created_at")
  updatedAt          DateTime        @map("updated_at")
  customer           PayableCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, provider])
  @@unique([provider, providerCustomerId])
  @@map("payable_customer_provider_bindings")
}

model PayableCustomerProviderSyncState {
  id                 String          @id
  tenantId           String?         @map("tenant_id")
  tenantKey          String          @default("") @map("tenant_key")
  customerId         String          @map("customer_id")
  provider           String
  status             String
  providerCustomerId String?         @map("provider_customer_id")
  attempts           Int
  lastAttemptedAt    DateTime        @map("last_attempted_at")
  synchronizedAt     DateTime?       @map("synchronized_at")
  failureCode        String?         @map("failure_code")
  attemptOwnerId     String?         @map("attempt_owner_id")
  leaseExpiresAt     DateTime?       @map("lease_expires_at")
  createdAt          DateTime        @map("created_at")
  updatedAt          DateTime        @map("updated_at")
  customer           PayableCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([tenantKey, customerId, provider])
  @@index([tenantKey, status])
  @@map("payable_customer_provider_sync_states")
}

model PayableProduct {
  id                String   @id
  tenantId          String?  @map("tenant_id")
  tenantKey         String   @default("") @map("tenant_key")
  provider          String
  providerProductId String?  @map("provider_product_id")
  name              String
  description       String?
  active            Boolean
  metadata          String?
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")

  @@unique([tenantKey, provider, providerProductId])
  @@map("payable_products")
}

model PayablePrice {
  id              String   @id
  tenantId        String?  @map("tenant_id")
  tenantKey       String   @default("") @map("tenant_key")
  provider        String
  providerPriceId String?  @map("provider_price_id")
  productId       String   @map("product_id")
  currency        String
  unitAmount      BigInt   @map("unit_amount")
  interval        String?
  intervalCount   Int?     @map("interval_count")
  active          Boolean
  createdAt       DateTime @map("created_at")
  updatedAt       DateTime @map("updated_at")

  @@unique([tenantKey, provider, providerPriceId])
  @@index([productId])
  @@map("payable_prices")
}

model PayableCanonicalProduct {
  id               String                          @id
  tenantId         String?                         @map("tenant_id")
  tenantKey        String                          @default("") @map("tenant_key")
  name             String
  description      String?
  active           Boolean
  metadata         String?
  createdAt        DateTime                        @map("created_at")
  updatedAt        DateTime                        @map("updated_at")
  prices           PayableCanonicalPrice[]
  providerBindings PayableProductProviderBinding[]

  @@unique([tenantKey, id])
  @@index([tenantKey, createdAt, id])
  @@map("payable_canonical_products")
}

model PayableCanonicalPrice {
  id                    String                              @id
  tenantId              String?                             @map("tenant_id")
  tenantKey             String                              @default("") @map("tenant_key")
  productId             String                              @map("product_id")
  currency              String
  unitAmount            BigInt                              @map("unit_amount")
  type                  String
  interval              String?
  intervalCount         Int?                                @map("interval_count")
  description           String?
  lookupKey             String?                             @map("lookup_key")
  active                Boolean
  createdAt             DateTime                            @map("created_at")
  updatedAt             DateTime                            @map("updated_at")
  product               PayableCanonicalProduct             @relation(fields: [tenantKey, productId], references: [tenantKey, id], onDelete: Restrict)
  providerBindings      PayablePriceProviderBinding[]
  sourcePriceMigrations PayableSubscriptionPriceMigration[] @relation("SubscriptionPriceMigrationSource")
  targetPriceMigrations PayableSubscriptionPriceMigration[] @relation("SubscriptionPriceMigrationTarget")

  @@unique([tenantKey, id])
  @@unique([tenantKey, lookupKey])
  @@index([tenantKey, productId, createdAt, id])
  @@index([tenantKey, createdAt, id])
  @@map("payable_canonical_prices")
}

model PayableProductProviderBinding {
  id                String                  @id
  tenantId          String?                 @map("tenant_id")
  tenantKey         String                  @default("") @map("tenant_key")
  productId         String                  @map("product_id")
  provider          String
  providerProductId String                  @map("provider_product_id")
  createdAt         DateTime                @map("created_at")
  updatedAt         DateTime                @map("updated_at")
  product           PayableCanonicalProduct @relation(fields: [tenantKey, productId], references: [tenantKey, id], onDelete: Cascade)

  @@unique([tenantKey, productId, provider])
  @@unique([tenantKey, provider, providerProductId])
  @@map("payable_product_provider_bindings")
}

model PayablePriceProviderBinding {
  id              String                @id
  tenantId        String?               @map("tenant_id")
  tenantKey       String                @default("") @map("tenant_key")
  priceId         String                @map("price_id")
  provider        String
  providerPriceId String                @map("provider_price_id")
  createdAt       DateTime              @map("created_at")
  updatedAt       DateTime              @map("updated_at")
  price           PayableCanonicalPrice @relation(fields: [tenantKey, priceId], references: [tenantKey, id], onDelete: Cascade)

  @@unique([tenantKey, priceId, provider])
  @@unique([tenantKey, provider, providerPriceId])
  @@map("payable_price_provider_bindings")
}

model PayableCatalogSynchronization {
  id                      String    @id
  tenantId                String?   @map("tenant_id")
  tenantKey               String    @default("") @map("tenant_key")
  provider                String
  resourceType            String    @map("resource_type")
  resourceId              String    @map("resource_id")
  operation               String
  canonicalVersion        String    @map("canonical_version")
  idempotencyKey          String    @map("idempotency_key")
  status                  String
  reconciliationState     String    @map("reconciliation_state")
  providerResourceId      String?   @map("provider_resource_id")
  providerResourceVersion String?   @map("provider_resource_version")
  retryCount              Int       @default(0) @map("retry_count")
  lastErrorCode           String?   @map("last_error_code")
  lastAttemptedAt         DateTime? @map("last_attempted_at")
  lastSucceededAt         DateTime? @map("last_succeeded_at")
  attemptOwnerId          String?   @map("attempt_owner_id")
  leaseExpiresAt          DateTime? @map("lease_expires_at")
  createdAt               DateTime  @map("created_at")
  updatedAt               DateTime  @map("updated_at")

  @@unique([tenantKey, provider, resourceType, resourceId])
  @@index([tenantKey, status, updatedAt])
  @@map("payable_catalog_synchronizations")
}

model PayableSubscription {
  id                             String                               @id
  tenantId                       String?                              @map("tenant_id")
  tenantKey                      String                               @default("") @map("tenant_key")
  customerId                     String                               @map("customer_id")
  name                           String
  provider                       String?
  providerSubscriptionId         String?                              @map("provider_subscription_id")
  status                         String
  priceId                        String?                              @map("price_id")
  quantity                       Int
  canonicalPriceId               String?                              @map("canonical_price_id")
  canonicalProductId             String?                              @map("canonical_product_id")
  acceptedCurrency               String?                              @map("accepted_currency")
  acceptedUnitAmount             BigInt?                              @map("accepted_unit_amount")
  acceptedInterval               String?                              @map("accepted_interval")
  acceptedIntervalCount          Int?                                 @map("accepted_interval_count")
  acceptedQuantity               Int?                                 @map("accepted_quantity")
  collectionResponsibility       String                               @default("provider") @map("collection_responsibility")
  creationSource                 String?                              @map("creation_source")
  trialEndsAt                    DateTime?                            @map("trial_ends_at")
  endsAt                         DateTime?                            @map("ends_at")
  currentPeriodStart             DateTime?                            @map("current_period_start")
  currentPeriodEnd               DateTime?                            @map("current_period_end")
  providerSyncedAt               DateTime?                            @map("provider_synced_at")
  scheduledChangeAction          String?                              @map("scheduled_change_action")
  scheduledChangeEffectiveAt     DateTime?                            @map("scheduled_change_effective_at")
  scheduledResumeAt              DateTime?                            @map("scheduled_resume_at")
  resumeBillingPolicy            String?                              @map("resume_billing_policy")
  paymentCollectionPauseBehavior String?                              @map("payment_collection_pause_behavior")
  paymentCollectionResumesAt     DateTime?                            @map("payment_collection_resumes_at")
  createdAt                      DateTime                             @map("created_at")
  updatedAt                      DateTime                             @map("updated_at")
  items                          PayableSubscriptionItem[]
  providerBindings               PayableSubscriptionProviderBinding[]
  priceMigrations                PayableSubscriptionPriceMigration[]
  mutationClaims                 PayableSubscriptionMutationClaim[]

  @@unique([tenantKey, id], map: "payable_subscriptions_tenant_id_unique")
  @@unique([tenantKey, provider, providerSubscriptionId])
  @@unique([tenantKey, customerId, name])
  @@index([customerId, createdAt, id])
  @@index([tenantKey, createdAt, id])
  @@index([tenantKey, canonicalProductId, createdAt, id], map: "payable_subscriptions_tenant_product_page_idx")
  @@map("payable_subscriptions")
}

model PayableSubscriptionProviderBinding {
  id                     String                              @id
  tenantId               String?                             @map("tenant_id")
  tenantKey              String                              @default("") @map("tenant_key")
  subscriptionId         String                              @map("subscription_id")
  provider               String
  providerSubscriptionId String                              @map("provider_subscription_id")
  providerSyncedAt       DateTime?                           @map("provider_synced_at")
  createdAt              DateTime                            @map("created_at")
  updatedAt              DateTime                            @map("updated_at")
  subscription           PayableSubscription                 @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  priceMigrations        PayableSubscriptionPriceMigration[]

  @@unique([tenantKey, id], map: "payable_subscription_bindings_tenant_id_unique")
  @@unique([tenantKey, subscriptionId, provider])
  @@unique([tenantKey, provider, providerSubscriptionId])
  @@map("payable_subscription_provider_bindings")
}

model PayableSubscriptionPriceMigration {
  id                                         String                             @id
  tenantKey                                  String                             @default("") @map("tenant_key")
  subscriptionId                             String                             @map("subscription_id")
  primaryItemId                              String                             @map("primary_item_id")
  activeSubscriptionId                       String?                            @map("active_subscription_id")
  sourcePriceId                              String                             @map("source_price_id")
  targetPriceId                              String                             @map("target_price_id")
  sourcePrice                                String                             @map("source_price")
  targetPrice                                String                             @map("target_price")
  currentItems                               String                             @map("current_items")
  proposedItems                              String                             @map("proposed_items")
  effectiveTiming                            String                             @map("effective_timing")
  effectiveAt                                DateTime?                          @map("effective_at")
  prorationPolicy                            String                             @map("proration_policy")
  paymentFailurePolicy                       String                             @map("payment_failure_policy")
  immediateAdjustment                        String                             @map("immediate_adjustment")
  nextRenewal                                String                             @map("next_renewal")
  currentRenewalDate                         DateTime?                          @map("current_renewal_date")
  warnings                                   String
  providerLimitations                        String                             @map("provider_limitations")
  providerEvidence                           String?                            @map("provider_evidence")
  previewToken                               String                             @map("preview_token")
  requestHash                                String                             @map("request_hash")
  calculatedAt                               DateTime                           @map("calculated_at")
  expiresAt                                  DateTime                           @map("expires_at")
  providerBindingId                          String                             @map("provider_binding_id")
  status                                     String
  attemptCount                               Int                                @map("attempt_count")
  executionToken                             String?                            @map("execution_token")
  failureCode                                String?                            @map("failure_code")
  failureMessage                             String?                            @map("failure_message")
  scheduledAt                                DateTime?                          @map("scheduled_at")
  executionStartedAt                         DateTime?                          @map("execution_started_at")
  appliedAt                                  DateTime?                          @map("applied_at")
  failedAt                                   DateTime?                          @map("failed_at")
  reconciliationRequiredAt                   DateTime?                          @map("reconciliation_required_at")
  reconciliationOutcome                      String?                            @map("reconciliation_outcome")
  reconciliationEvidenceReference            String?                            @map("reconciliation_evidence_reference")
  reconciliationResolvedAt                   DateTime?                          @map("reconciliation_resolved_at")
  reconciliationObservationEvidenceReference String?                            @map("reconciliation_observation_evidence_reference")
  reconciliationObservedAt                   DateTime?                          @map("reconciliation_observed_at")
  cancelledAt                                DateTime?                          @map("cancelled_at")
  createdAt                                  DateTime                           @map("created_at")
  updatedAt                                  DateTime                           @map("updated_at")
  subscription                               PayableSubscription                @relation(fields: [tenantKey, subscriptionId], references: [tenantKey, id], onDelete: Restrict)
  sourcePriceRelation                        PayableCanonicalPrice              @relation("SubscriptionPriceMigrationSource", fields: [tenantKey, sourcePriceId], references: [tenantKey, id], onDelete: Restrict)
  targetPriceRelation                        PayableCanonicalPrice              @relation("SubscriptionPriceMigrationTarget", fields: [tenantKey, targetPriceId], references: [tenantKey, id], onDelete: Restrict)
  providerBinding                            PayableSubscriptionProviderBinding @relation(fields: [tenantKey, providerBindingId], references: [tenantKey, id], onDelete: Restrict)

  @@unique([tenantKey, id], map: "payable_subscription_price_migrations_tenant_id_unique")
  @@unique([tenantKey, activeSubscriptionId], map: "payable_subscription_price_migrations_active_unique")
  @@index([tenantKey, status, createdAt, id], map: "payable_subscription_price_migrations_tenant_status_page_index")
  @@index([tenantKey, subscriptionId, createdAt, id], map: "payable_subscription_price_migrations_subscription_page_index")
  @@index([tenantKey, status, effectiveAt, id], map: "payable_subscription_price_migrations_due_index")
  @@map("payable_subscription_price_migrations")
}

model PayableSubscriptionMutationClaim {
  claimReference               String              @id @map("claim_reference")
  tenantKey                    String              @default("") @map("tenant_key")
  subscriptionId               String              @map("subscription_id")
  activeSubscriptionId         String?             @map("active_subscription_id")
  ownerToken                   String              @unique(map: "payable_subscription_mutation_claims_owner_unique") @map("owner_token")
  operation                    String
  correlationId                String              @map("correlation_id")
  intent                       String?
  status                       String
  resolutionOutcome            String?             @map("resolution_outcome")
  resolutionEvidenceReference  String?             @map("resolution_evidence_reference")
  resolvedAt                   DateTime?           @map("resolved_at")
  observationOutcome           String?             @map("observation_outcome")
  observationEvidenceReference String?             @map("observation_evidence_reference")
  observedAt                   DateTime?           @map("observed_at")
  claimedAt                    DateTime            @map("claimed_at")
  subscription                 PayableSubscription @relation(fields: [tenantKey, subscriptionId], references: [tenantKey, id], onDelete: Restrict)

  @@unique([tenantKey, activeSubscriptionId], map: "payable_subscription_mutation_claims_active_unique")
  @@map("payable_subscription_mutation_claims")
}

model PayableSubscriptionItem {
  id             String              @id
  subscriptionId String              @map("subscription_id")
  priceId        String              @map("price_id")
  providerItemId String?             @map("provider_item_id")
  quantity       Int
  createdAt      DateTime            @map("created_at")
  updatedAt      DateTime            @map("updated_at")
  subscription   PayableSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("payable_subscription_items")
}

model PayableCanonicalInvoice {
  id               String                          @id
  tenantId         String?                         @map("tenant_id")
  tenantKey        String                          @default("") @map("tenant_key")
  customerId       String                          @map("customer_id")
  subscriptionId   String?                         @map("subscription_id")
  status           String
  currency         String
  total            BigInt
  amountPaid       BigInt                          @map("amount_paid")
  amountDue        BigInt                          @map("amount_due")
  number           String?
  hostedInvoiceUrl String?                         @map("hosted_invoice_url")
  invoicePdf       String?                         @map("invoice_pdf")
  createdAt        DateTime                        @map("created_at")
  updatedAt        DateTime                        @map("updated_at")
  providerBindings PayableInvoiceProviderBinding[]
  payments         PayableInvoicePayment[]

  @@unique([tenantKey, id])
  @@index([tenantKey, createdAt, id])
  @@index([tenantKey, customerId, createdAt, id])
  @@map("payable_canonical_invoices")
}

model PayableInvoiceProviderBinding {
  id                   String                  @id
  tenantId             String?                 @map("tenant_id")
  tenantKey            String                  @default("") @map("tenant_key")
  invoiceId            String                  @map("invoice_id")
  provider             String
  providerResourceType String                  @map("provider_resource_type")
  providerResourceId   String                  @map("provider_resource_id")
  createdAt            DateTime                @map("created_at")
  updatedAt            DateTime                @map("updated_at")
  invoice              PayableCanonicalInvoice @relation(fields: [tenantKey, invoiceId], references: [tenantKey, id], onDelete: Cascade)

  @@unique([tenantKey, invoiceId, provider])
  @@unique([tenantKey, provider, providerResourceType, providerResourceId])
  @@map("payable_invoice_provider_bindings")
}

model PayableInvoicePayment {
  tenantId  String?                 @map("tenant_id")
  tenantKey String                  @default("") @map("tenant_key")
  invoiceId String                  @map("invoice_id")
  paymentId String                  @map("payment_id")
  createdAt DateTime                @map("created_at")
  invoice   PayableCanonicalInvoice @relation(fields: [tenantKey, invoiceId], references: [tenantKey, id], onDelete: Cascade)
  payment   PayablePayment          @relation(fields: [tenantKey, paymentId], references: [tenantKey, id], onDelete: Restrict)

  @@id([tenantKey, invoiceId, paymentId])
  @@index([tenantKey, invoiceId, createdAt, paymentId])
  @@map("payable_invoice_payments")
}

model PayableMigrationReport {
  migrationName String   @id @map("migration_name")
  report        String
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  @@map("payable_migration_reports")
}

model PayableInvoice {
  id                String   @id
  tenantId          String?  @map("tenant_id")
  customerId        String   @map("customer_id")
  subscriptionId    String?  @map("subscription_id")
  provider          String
  providerInvoiceId String?  @map("provider_invoice_id")
  status            String
  currency          String
  total             BigInt
  amountPaid        BigInt   @map("amount_paid")
  amountDue         BigInt   @map("amount_due")
  number            String?
  hostedInvoiceUrl  String?  @map("hosted_invoice_url")
  invoicePdf        String?  @map("invoice_pdf")
  createdAt         DateTime @map("created_at")
  updatedAt         DateTime @map("updated_at")

  @@unique([provider, providerInvoiceId])
  @@index([customerId, createdAt, id])
  @@map("payable_invoices")
}

model PayablePayment {
  id                String                  @id
  tenantId          String?                 @map("tenant_id")
  tenantKey         String                  @default("") @map("tenant_key")
  customerId        String?                 @map("customer_id")
  provider          String?
  providerPaymentId String?                 @map("provider_payment_id")
  status            String
  currency          String
  amount            BigInt
  refundedAmount    BigInt                  @map("refunded_amount")
  capturedAmount    BigInt                  @default(0) @map("captured_amount")
  authorizedAt      DateTime?               @map("authorized_at")
  authorizationExpiresAt DateTime?          @map("authorization_expires_at")
  reference         String?
  description       String?
  collectionMethod  String?                 @map("collection_method")
  occurredAt        DateTime?               @map("occurred_at")
  externalReference String?                 @map("external_reference")
  recordedBy        String?                 @map("recorded_by")
  createdAt         DateTime                @map("created_at")
  updatedAt         DateTime                @map("updated_at")
  refunds           PayableRefund[]
  invoicePayments   PayableInvoicePayment[]

  @@unique([provider, providerPaymentId])
  @@unique([tenantKey, id])
  @@index([customerId, createdAt, id])
  @@index([tenantKey, createdAt, id])
  @@map("payable_payments")
}

model PayableRefund {
  id                String         @id
  tenantId          String?        @map("tenant_id")
  paymentId         String         @map("payment_id")
  provider          String?
  providerRefundId  String?        @map("provider_refund_id")
  status            String
  currency          String
  amount            BigInt
  reason            String?
  collectionMethod  String?        @map("collection_method")
  occurredAt        DateTime?      @map("occurred_at")
  externalReference String?        @map("external_reference")
  recordedBy        String?        @map("recorded_by")
  createdAt         DateTime       @map("created_at")
  updatedAt         DateTime       @map("updated_at")
  payment           PayablePayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRefundId])
  @@index([paymentId, createdAt, id])
  @@map("payable_refunds")
}

model PayableWebhookEvent {
  id              String    @id
  tenantId        String    @default("") @map("tenant_id")
  provider        String
  providerEventId String    @map("provider_event_id")
  type            String
  normalizedType  String?   @map("normalized_type")
  payload         String
  signature       String?
  data            String
  headers         String
  status          String
  correlationId   String    @map("correlation_id")
  occurredAt      DateTime? @map("occurred_at")
  receivedAt      DateTime  @map("received_at")
  processedAt     DateTime? @map("processed_at")
  claimedUntil    DateTime? @map("claimed_until")
  claimToken      String?   @map("claim_token")

  @@unique([tenantId, provider, providerEventId])
  @@index([tenantId, receivedAt, id])
  @@map("payable_webhook_events")
}

model PayableIdempotencyKey {
  id           String    @id
  tenantId     String    @default("") @map("tenant_id")
  key          String
  scope        String
  operation    String
  resourceType String?   @map("resource_type")
  resourceId   String?   @map("resource_id")
  requestHash  String    @map("request_hash")
  response     String?
  status       String
  lockedUntil  DateTime? @map("locked_until")
  lockToken    String?   @map("lock_token")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")

  @@unique([tenantId, key])
  @@map("payable_idempotency_keys")
}

model PayableAuditLog {
  id            String   @id
  tenantId      String   @default("") @map("tenant_id")
  correlationId String   @map("correlation_id")
  actorType     String?  @map("actor_type")
  actorId       String?  @map("actor_id")
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String   @map("resource_id")
  before        String?
  after         String?
  metadata      String?
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  previousHash  String?  @map("previous_hash")
  hash          String
  sequence      Int?
  createdAt     DateTime @map("created_at")

  @@unique([tenantId, sequence])
  @@index([resourceType, resourceId])
  @@index([correlationId])
  @@map("payable_audit_logs")
}

model PayableOutboxEvent {
  id            String    @id
  tenantId      String?   @map("tenant_id")
  correlationId String    @map("correlation_id")
  eventType     String    @map("event_type")
  eventVersion  Int       @map("event_version")
  payload       String
  status        String
  attempts      Int
  nextRetryAt   DateTime? @map("next_retry_at")
  lockedBy      String?   @map("locked_by")
  lockedUntil   DateTime? @map("locked_until")
  dedupeKey     String?   @map("dedupe_key")
  tenantKey     String    @default("") @map("tenant_key")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")

  @@unique([tenantKey, dedupeKey])
  @@index([status, nextRetryAt, createdAt, id])
  @@index([status, lockedUntil, createdAt, id])
  @@map("payable_outbox_events")
}

model PayableWebhookEndpoint {
  id         String                        @id
  tenantId   String?                       @map("tenant_id")
  url        String
  events     String
  secret     String?
  status     String
  createdAt  DateTime                      @map("created_at")
  updatedAt  DateTime                      @map("updated_at")
  eventLinks PayableWebhookEndpointEvent[]

  @@map("payable_webhook_endpoints")
}

model PayableWebhookEndpointEvent {
  endpointId String                 @map("endpoint_id")
  eventType  String                 @map("event_type")
  endpoint   PayableWebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@id([endpointId, eventType])
  @@index([eventType])
  @@map("payable_webhook_endpoint_events")
}

model PayableWebhookDelivery {
  id           String    @id
  tenantId     String?   @map("tenant_id")
  endpointId   String    @map("endpoint_id")
  eventId      String?   @map("event_id")
  eventType    String    @map("event_type")
  payload      String
  status       String
  attempts     Int
  responseCode Int?      @map("response_code")
  responseBody String?   @map("response_body")
  nextRetryAt  DateTime? @map("next_retry_at")
  tenantKey    String    @default("") @map("tenant_key")
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")

  @@unique([tenantKey, endpointId, eventId])
  @@index([endpointId])
  @@index([endpointId, eventId])
  @@map("payable_webhook_deliveries")
}
